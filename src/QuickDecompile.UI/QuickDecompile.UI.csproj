<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Target net8.0-windows for Windows-specific features (registry), but keep the
         rest of the UI code cross-platform. On non-Windows, Shell uses NullShellIntegration. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>QuickDecompile.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"/>
    <AvaloniaResource Include="Styles\**"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"                   Version="12.1.4"/>
    <PackageReference Include="Avalonia.Desktop"           Version="12.1.4"/>
    <PackageReference Include="Avalonia.Themes.Fluent"     Version="12.1.4"/>
    <PackageReference Include="Avalonia.Fonts.Inter"       Version="12.1.4"/>
    <PackageReference Include="Avalonia.AvaloniaEdit"      Version="12.0.0"/>
    <PackageReference Include="AvaloniaEdit.TextMate"      Version="12.0.0"/>
    <PackageReference Include="CommunityToolkit.Mvvm"      Version="8.4.2"/>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickDecompile.Core\QuickDecompile.Core.csproj"/>
    <ProjectReference Include="..\QuickDecompile.Backends\QuickDecompile.Backends.csproj"/>
    <ProjectReference Include="..\QuickDecompile.Shell\QuickDecompile.Shell.csproj"/>
  </ItemGroup>
</Project>
