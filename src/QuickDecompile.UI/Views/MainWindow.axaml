<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickDecompile.UI.ViewModels"
        xmlns:views="using:QuickDecompile.UI.Views"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="QuickDecompile.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200" Height="750"
        MinWidth="600" MinHeight="400"
        Icon="/Assets/avalonia-logo.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <StyleInclude Source="/Styles/AppStyles.axaml"/>
  </Window.Styles>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileDialogCommand}"/>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCurrentTabCommand}"/>
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseSelectedTabCommand}"/>
  </Window.KeyBindings>

  <Grid RowDefinitions="40,Auto,*,Auto">

    
    <Grid Grid.Row="0" Background="Transparent" IsHitTestVisible="False">
      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
    </Grid>

    
    <Menu Grid.Row="1" Margin="8,0,0,0">
      <MenuItem Header="_File">
        <MenuItem Header="_Open File…"  Command="{Binding OpenFileDialogCommand}" InputGesture="Ctrl+O"/>
        <MenuItem Header="_Save Code As…" Command="{Binding SaveCurrentTabCommand}" InputGesture="Ctrl+S"/>
        <Separator/>
        <MenuItem Header="_Close Tab" Command="{Binding CloseSelectedTabCommand}" InputGesture="Ctrl+W"/>
        <Separator/>
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Toggle _Dark/Light Theme" Command="{Binding ToggleThemeCommand}"/>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="Add to _Context Menu"
                  Command="{Binding InstallContextMenuCommand}"
                  IsEnabled="{Binding !IsContextMenuInstalled}"/>
        <MenuItem Header="_Remove from Context Menu"
                  Command="{Binding UninstallContextMenuCommand}"
                  IsEnabled="{Binding IsContextMenuInstalled}"/>
      </MenuItem>
    </Menu>

    
    <Grid Grid.Row="2">

      
      <StackPanel IsVisible="{Binding !Tabs.Count}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12">
        <TextBlock Text="QuickDecompile"
                   FontSize="32" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Opacity="0.2"/>
        <TextBlock Text="Drop a .class, .jar, .apk, .dll or .exe file here"
                   HorizontalAlignment="Center"
                   Opacity="0.4"/>
        <Button Content="Open File…"
                Command="{Binding OpenFileDialogCommand}"
                HorizontalAlignment="Center"
                Classes="accent"/>
      </StackPanel>

      
      <TabControl IsVisible="{Binding Tabs.Count}"
                  ItemsSource="{Binding Tabs}"
                  SelectedItem="{Binding SelectedTab}">

        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TabViewModel">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Header}"
                         VerticalAlignment="Center"
                         MaxWidth="200"
                         TextTrimming="CharacterEllipsis"/>
              <Button Grid.Column="1"
                      Content="✕"
                      Classes="tabClose"
                      Command="{Binding RequestCloseCommand}"
                      ToolTip.Tip="Close tab"/>
            </Grid>
          </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
          <DataTemplate x:DataType="vm:TabViewModel">
            <views:TabContentView DataContext="{Binding}"/>
          </DataTemplate>
        </TabControl.ContentTemplate>

      </TabControl>

    </Grid>

    
    <Border Grid.Row="3" Classes="statusBar">
      <TextBlock Text="{Binding StatusText}" Margin="8,4" FontSize="12" Opacity="0.7"/>
    </Border>

  </Grid>
</Window>
